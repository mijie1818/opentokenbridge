# 商业化One API配置 - 反向代购系统
# 目标：将国产模型包装成OpenAI接口卖给海外开发者

# ==================== 数据库配置 ====================
# Supabase 数据库配置
DB_HOST=db.uenhdkhobpylqblkxuvd.supabase.co
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=Mihansen20220812*
DB_NAME=postgres

# ==================== 管理员账户 ====================
ADMIN_PASSWORD=change_this_immediately_after_deployment

# ==================== 商业化设置 ====================
# 定价策略
TOKEN_PRICE=0.0005  # $0.50 per million tokens
QUOTA_PER_DOLLAR=2000000  # 2 million tokens per $1
CURRENCY=USD
BILLING_ENABLED=true

# 免费额度设置
FREE_QUOTA=100000  # 10万token免费额度
FREE_QUOTA_EXPIRY_DAYS=30  # 免费额度有效期30天

# ==================== 国产模型配置 ====================
# DeepSeek配置
DEEPSEEK_API_KEY=sk_3170be12f4db41098607aa241dd20550
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 智谱AI配置 (可选)
ZHIPU_API_KEY=your-zhipu-api-key
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4

# 百度文心配置 (可选)
BAIDU_API_KEY=your-baidu-api-key
BAIDU_SECRET_KEY=your-baidu-secret
BAIDU_BASE_URL=https://aip.baidubce.com/rpc/2.0/ai_custom/v1/wenxinworkshop
BAIDU_MODEL=ernie-4.0-8k

# ==================== 安全配置 ====================
# 自动生成，无需修改
SESSION_SECRET=auto_generated
JWT_SECRET=auto_generated

# 速率限制
RATE_LIMIT_ENABLED=true
MAX_REQUEST_PER_MINUTE=100
MAX_TOKENS_PER_MINUTE=100000

# IP限制 (可选)
ALLOWED_IPS=0.0.0.0/0  # 允许所有IP，或设置特定范围

# ==================== 性能优化 ====================
CACHE_ENABLED=true
CACHE_TTL=300  # 5分钟缓存
REDIS_DSN=redis://:password@host:6379/0  # 如果使用Redis

# ==================== 监控和日志 ====================
LOG_LEVEL=info
LOG_DIR=/data/logs
TELEMETRY_ENABLED=true

# 告警设置
ALERT_EMAIL=your-email@example.com
SLACK_WEBHOOK=https://hooks.slack.com/services/xxx

# ==================== 域名和SSL ====================
CUSTOM_DOMAIN=api.your-domain.com
FORCE_HTTPS=true

# ==================== 支付集成 ====================
# Stripe配置
STRIPE_SECRET_KEY=sk_live_xxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx

# PayPal配置 (可选)
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-secret
PAYPAL_MODE=live

# ==================== 邮件服务 ====================
# 用户注册、账单通知等
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@your-domain.com

# ==================== 业务逻辑 ====================
# 模型路由策略
DEFAULT_MODEL=deepseek-chat
FALLBACK_MODELS=zhipu-glm-4,baidu-ernie-4.0

# 价格倍率 (成本 vs 售价)
DEEPSEEK_PRICE_MULTIPLIER=3.5  # DeepSeek成本 $0.14/百万token，售价 $0.50/百万token
ZHIPU_PRICE_MULTIPLIER=2.8
BAIDU_PRICE_MULTIPLIER=3.0

# ==================== 运营设置 ====================
COMPANY_NAME=China AI Proxy
SUPPORT_EMAIL=support@your-domain.com
TERMS_URL=https://your-domain.com/terms
PRIVACY_URL=https://your-domain.com/privacy

# 自动扩缩容
AUTO_SCALE_MIN_INSTANCES=2
AUTO_SCALE_MAX_INSTANCES=10
AUTO_SCALE_CPU_THRESHOLD=70
AUTO_SCALE_MEMORY_THRESHOLD=80